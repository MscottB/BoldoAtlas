{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoldoAtlas",
  "version": "0.1.0",
  "identifier": "io.github.mscottb.boldoatlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BoldoAtlas",
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyRjgxNTVFMEJDNUYyOTIKUldTUzhzVUxYaFg0OHZsQWt5aDhHd2M0VllmUlY5aEFXZFVCMWJuMFZCQ1VsMUY0TnFtaWgxRlYK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Michael Jim Scott Bravo",
    "copyright": "© 2026 Michael Jim Scott Bravo · AGPL-3.0",
    "category": "Productivity",
    "shortDescription": "Organigrama, procesos y fichas de trabajadores",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "template": "instalador/plantilla.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "instalador/encabezado.bmp",
        "sidebarImage": "instalador/lateral.bmp",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "instalador/fondo-dmg.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
